# Test de Integraciones SEQUENTIA — plantilla de configuración.
#
# Copiala a `.env` (o corré `sq-mcp init`, que crea ~/.config/sq-mcp/.env).
# El `.env` real NO se versiona: contiene tu API key.

# Tu API key de Sequentia.
SQ_MCP_TOKEN=

# Opcional: solo si apuntás a un despliegue propio de Sequentia.
# SQ_MCP_URL=https://mcp.sequentia.co/mcp
